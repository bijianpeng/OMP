# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 应用标题（应用名称唯一来源，勿带 OMP 前缀）
VITE_APP_TITLE=运维管理平台

# 应用命名空间(localStorage/缓存键前缀,隔离不同应用的持久化数据)
VITE_APP_NAMESPACE=omp
