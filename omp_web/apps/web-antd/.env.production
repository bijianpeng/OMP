VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 应用标题（应用名称唯一来源，勿带 OMP 前缀）
VITE_APP_TITLE=运维管理平台

# 应用命名空间(localStorage/缓存键前缀,隔离不同应用的持久化数据)
VITE_APP_NAMESPACE=omp
